# Public values used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
RESEND_API_KEY=your-server-only-resend-key
EMAIL_FROM=Weekend School <reports@example.com>
CRON_SECRET=replace-with-a-long-random-secret

# Optional Playwright target; omit to use http://127.0.0.1:3000.
E2E_BASE_URL=http://127.0.0.1:3000
